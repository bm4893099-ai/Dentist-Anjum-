# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/anjum-dentist?retryWrites=true&w=majority

# JWT Secret (change this to a long, random string in production)
JWT_SECRET=anjum-dentist-super-secret-jwt-key-change-in-production

# Admin Credentials (stored server-side, never exposed to client)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Next.js
NEXTAUTH_URL=http://localhost:3000

# Public site URL (used for QR code generation - set to your live domain)
NEXT_PUBLIC_SITE_URL=https://ewsest.com
